{
  "mcpServers": {
    "nexalink": {
      "type": "http",
      "url": "https://nexalink.cubixos.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.82",
        "--browser",
        "chromium",
        "--output-dir",
        "${TEMP:-/tmp}/nexalink",
        "--file-paths",
        "absolute"
      ]
    }
  }
}
